# Public runtime configuration for the Nuxt frontend
# If left empty, the app will use built-in mock API endpoints under /api/recipes
NUXT_PUBLIC_API_BASE=

# Optional environment variables (unused by the core flow but reserved)
NUXT_PUBLIC_BACKEND_URL=
NUXT_PUBLIC_FRONTEND_URL=
NUXT_PUBLIC_WS_URL=
NUXT_PUBLIC_NODE_ENV=development
NUXT_PUBLIC_NEXT_TELEMETRY_DISABLED=1
NUXT_PUBLIC_ENABLE_SOURCE_MAPS=0
NUXT_PUBLIC_PORT=3000
NUXT_PUBLIC_TRUST_PROXY=1
NUXT_PUBLIC_LOG_LEVEL=info
NUXT_PUBLIC_HEALTHCHECK_PATH=/health
# For feature gating; set JSON like {"newUI":true}
NUXT_PUBLIC_FEATURE_FLAGS={}
NUXT_PUBLIC_EXPERIMENTS_ENABLED=0
